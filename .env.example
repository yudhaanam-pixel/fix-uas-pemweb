# ====================================================================
# KONFIGURASI SUPABASE (PostgreSQL & Auth)
# ====================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ====================================================================
# KONFIGURASI CLOUDFLARE R2 (Penyimpanan Berkas Medis / S3 API)
# ====================================================================
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=sim-klinik-files
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev

# ====================================================================
# APP CONFIG
# ====================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

